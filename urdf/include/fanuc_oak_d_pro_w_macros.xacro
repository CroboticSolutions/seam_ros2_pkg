<?xml version="1.0"?>
<!--
  FANUC CRX + OAK-D Pro W (depthai OAK-D-PRO URDF frames).

  Eye-in-hand mount on J6_link for Gazebo simulation, so the camera stays
  rigid with the welding gun (torch hangs off the J6/flange chain).
  Re-calibrate with hand_eye_calibration when a physical camera is mounted.

  The OAK looks along +X of oak-d-base-frame (= J6_link +X, the tool/weld
  approach axis) with a 20 deg downward pitch. In J6_link coords the flange
  sits at ~(0.16, 0, 0) and the welding_tcp / nozzle at ~(0.57, 0, -0.01), so
  (0.30, 0, 0.13) places the camera above the mid-gun, looking forward-down
  toward the weld point.

  (Previous mount: J5_link, xyz = 0.30 -0.15 0.10, pitch +30 deg.)

  J6_link → oak-d-base-frame:
    xyz = 0.300000000 0.000000000 0.130000000
    rpy = 0.000000000 0.349065850 0.000000000   (0, +20 deg pitch, 0)
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="fanuc_oak_d_pro_w_attachment_defs">
  <xacro:include filename="$(find depthai_descriptions_v3)/urdf/include/depthai_macro.urdf.xacro"/>

  <xacro:macro name="fanuc_mount_oak_d_pro_w" params="parent_link simulation:=false oak_gazebo_rgbd_sensor:=false">
    <link name="oak-d-base-frame"/>
    <joint name="fanuc_oak_j6_mount" type="fixed">
      <origin
        xyz="0.300000000 0.000000000 0.130000000"
        rpy="0.000000000 0.349065850 0.000000000"/>
      <parent link="${parent_link}"/>
      <child link="oak-d-base-frame"/>
    </joint>

    <xacro:depthai_camera
      camera_name="oak"
      parent="oak-d-base-frame"
      camera_model="OAK-D-PRO"
      base_frame="oak-d_frame"
      cam_pos_x="0.0"
      cam_pos_y="0.0"
      cam_pos_z="0.0"
      cam_roll="0.0"
      cam_pitch="0.0"
      cam_yaw="0.0"
      simulation="${simulation}"
      rs_compat="false"
      a="0.0"/>

    <xacro:if value="${oak_gazebo_rgbd_sensor}">
      <gazebo reference="oak_rgb_camera_frame">
        <sensor name="camera" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.02</near>
              <far>300</far>
            </clip>
          </camera>
          <depth_camera>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.02</near>
              <far>10.0</far>
            </clip>
            <point_cloud>true</point_cloud>
          </depth_camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
