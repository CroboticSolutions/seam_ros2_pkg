<?xml version="1.0"?>
<!--
  FANUC CRX + Intel RealSense D435 (eye-in-hand on J6_link).

  Frame names match realsense2_camera rs_launch.py defaults (camera_name camera):
    camera_link, camera_color_optical_frame, etc.

  Do NOT run rs_launch.py with publish_tf true. robot_state_publisher owns
  the camera TF tree via this macro.

    PLACEHOLDER mount intentionally reuses the FANUC OAK-D Pro W mid-gun pose
  (same xyz/rpy as fanuc_oak_d_pro_w_macros.xacro). Optical frame names still
  match realsense2_camera (camera_color_optical_frame, …). After site hand-eye,
  bake with hand_eye_calibration.realsense_mount_cli
  (joint name fanuc_j6_realsense_d435_mount), then rebuild seam_ros2_pkg.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="fanuc_realsense_d435_attachment_defs">

  <xacro:macro name="fanuc_mount_realsense_d435_handeye" params="parent_link use_mesh:=true">
    <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro"/>

    <link name="fanuc_realsense_mount"/>
    <joint name="fanuc_j6_realsense_d435_mount" type="fixed">
      <!-- OAK mid-gun mount (fanuc_oak_d_pro_w); fine until site hand-eye. -->
      <origin
        xyz="0.300000000000 0.000000000000 0.130000000000"
        rpy="0.000000000000 0.349065850000 0.000000000000"/>
      <parent link="${parent_link}"/>
      <child link="fanuc_realsense_mount"/>
    </joint>

    <xacro:sensor_d435
      parent="fanuc_realsense_mount"
      name="camera"
      use_nominal_extrinsics="true"
      add_plug="false"
      use_mesh="${use_mesh}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:sensor_d435>
  </xacro:macro>

</robot>
