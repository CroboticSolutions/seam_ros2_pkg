Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Robot1
    - /Kamera1
    - /Welding1
    - /Scan i registracija1
    - /WiLoR ruka1
    - /Kalibracija1
    Splitter Ratio: 0.6
  Tree Height: 560
- Class: rviz_common/Help
  Name: Help
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Value: true
  - Class: moveit_rviz_plugin/MotionPlanning
    Name: MotionPlanning
    Planned Path:
      Loop Animation: true
      State Display Time: 0.05 s
      Trajectory Topic: display_planned_path
    Planning Scene Topic: monitored_planning_scene
    Robot Description: robot_description
    Scene Geometry:
      Scene Alpha: 1
    Scene Robot:
      Robot Alpha: 0.5
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Pose
      Name: TCP poza
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.01
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /arm/state/tcp_pose
      Enabled: false
      Value: false
    Enabled: true
    Name: Robot
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_common/Group
      Displays:
      - Class: rviz_default_plugins/Image
        Name: Sim Gazebo slika
        Max Value: 1
        Median window: 5
        Min Value: 0
        Normalize Range: true
        Topic:
          Depth: 1
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /crx10ia/camera/image_raw
        Enabled: false
        Value: false
      - Class: rviz_default_plugins/PointCloud2
        Name: Sim Gazebo oblak
        Alpha: 1
        Color: 255; 255; 255
        Color Transformer: RGB8
        Decay Time: 0
        Position Transformer: XYZ
        Selectable: true
        Size (Pixels): 2
        Size (m): 0.01
        Style: Points
        Topic:
          Depth: 5
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /crx10ia/camera/points_reframed
        Use Fixed Frame: true
        Enabled: false
        Value: false
      Enabled: true
      Name: Sim Gazebo
      Value: true
    - Class: rviz_common/Group
      Displays:
      - Class: rviz_default_plugins/Image
        Name: D435 hybrid slika
        Max Value: 1
        Median window: 5
        Min Value: 0
        Normalize Range: true
        Topic:
          Depth: 1
          Durability Policy: Volatile
          Filter size: 10
          History Policy: Keep Last
          Reliability Policy: Best Effort
          Value: /camera/camera/color/image_raw
        Enabled: false
        Value: false
      Enabled: true
      Name: D435 hybrid
      Value: true
    Enabled: true
    Name: Kamera
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/Path
      Name: Edge snap put
      Alpha: 1
      Buffer Length: 1
      Color: 255; 170; 0
      Line Style: Billboards
      Line Width: 0.004
      Pose Style: Axes
      Pose Axes Length: 0.02
      Pose Axes Radius: 0.002
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /welding/edge_snap/path
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Marker
      Name: Edge snap odabrani rub
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /welding/edge_snap/selected_marker
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Marker
      Name: Trajektorija 3D
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /trajectory_3d
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Path
      Name: Trajektorija put
      Alpha: 1
      Buffer Length: 1
      Color: 0; 200; 255
      Line Style: Billboards
      Line Width: 0.004
      Pose Style: Axes
      Pose Axes Length: 0.02
      Pose Axes Radius: 0.002
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /trajectory_path
      Enabled: false
      Value: false
    Enabled: true
    Name: Welding
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Scan oblak
      Alpha: 1
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /object_scan/cloud
      Use Fixed Frame: true
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Scan fuzionirani oblak
      Alpha: 1
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /object_scan/fused_cloud
      Use Fixed Frame: true
      Enabled: false
      Value: false
    Enabled: true
    Name: Scan i registracija
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: Mesh ruke
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wilor/mesh_markers
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Osi ruke debug
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wilor/debug_axes
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Pose
      Name: Poza ruke
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.01
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wilor/hand_pose
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Pose
      Name: Vrh kaziprsta
      Shape: Axes
      Axes Length: 0.04
      Axes Radius: 0.005
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wilor/index_fingertip
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Pose
      Name: Kontaktna tocka
      Shape: Axes
      Axes Length: 0.04
      Axes Radius: 0.005
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wilor/index_contact_point
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/PointCloud2
      Name: Vrhovi mesha
      Alpha: 1
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wilor/hand_visual_vertices
      Use Fixed Frame: true
      Enabled: false
      Value: false
    Enabled: true
    Name: WiLoR ruka
    Value: true
  - Class: rviz_common/Group
    Displays:
    - Class: rviz_default_plugins/Image
      Name: ChArUco detekcija
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /charuco_detector/image_annotated
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/Marker
      Name: Procjena ploce
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /hand_eye_calibration/board_estimate
      Enabled: false
      Value: false
    Enabled: true
    Name: Kalibracija
    Value: true
  Global Options:
    Fixed Frame: world
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.5
      Name: Current View
      Pitch: 0.4
      Target Frame: world
      Yaw: 0.8
Window Geometry:
  Displays:
    collapsed: false
  Height: 1400
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 2400
  X: 80
  Y: 60
