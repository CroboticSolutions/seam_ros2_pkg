# FANUC CRX-10iA real site defaults (source before launching gui_stack / wizard).
# Copy to arms_ws/.env.fanuc_real.local and fill in site values.

FANUC_ROBOT_IP=192.168.1.100
FANUC_ARM_API2_DELAY_S=12
FANUC_MOVEIT_DELAY_S=8

# Hand-eye / calibration frames for CRX eye-in-hand on J6
CALIB_ROBOT_BASE_FRAME=base_link
CALIB_ROBOT_EFFECTOR_FRAME=J6_link

# Optional topic overrides (defaults match RealSense D435 rs_launch)
# FANUC_CAMERA_IMAGE_TOPIC=/camera/camera/color/image_raw
# FANUC_CAMERA_POINTS_TOPIC=/camera/camera/depth/color/points

# Welding edge cloud rebuild (1=on)
WELDING_EDGE_ALIGNED_CLOUD=1
